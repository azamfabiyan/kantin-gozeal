// Kantin Gozeal - Sistem Manajemen Jatah Makanan & Minuman Karyawan
// v7: Carry-over balance system (saldo menumpuk ke periode berikutnya)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // When using Turso adapter, url is not used for actual connection
  // The adapter (PrismaLibSql) handles the real connection
  // For local dev: file:/path/to/db
  // For Vercel: libsql://... (adapter overrides)
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  dateOfBirth String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  pickups     Pickup[]
  balances    EmployeeBalance[]
}

model Variant {
  id           String            @id @default(cuid())
  name         String
  type         String
  stock        Int
  initialStock Int
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  pickups      Pickup[]
  stockHistory StockHistory[]
  balances     EmployeeBalance[]
}

model Pickup {
  id         String   @id @default(cuid())
  employeeId String
  variantId  String
  type       String
  period     String
  timestamp  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([employeeId, period])
  @@index([period])
  @@index([variantId, period])
}

model EmployeeBalance {
  id         String   @id @default(cuid())
  employeeId String
  variantId  String
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, variantId])
  @@index([employeeId])
  @@index([variantId])
}

model PeriodSetting {
  id            String   @id @default(cuid())
  currentPeriod String   @unique
  startedAt     DateTime @default(now())
  resetBy       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockHistory {
  id         String   @id @default(cuid())
  variantId  String
  changeType String
  amount     Int
  oldStock   Int
  newStock   Int
  note       String?
  changedBy  String
  createdAt  DateTime @default(now())
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}
